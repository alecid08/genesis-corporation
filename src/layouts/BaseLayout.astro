---
import '../styles/global.css';
import { getPalette } from '../lib/palettes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  robots?: string;
  /** CSS extra inyectado tras la paleta, ej. los tokens de un estilo de landing. */
  extraStyleCss?: string;
  /** Hoja de fuentes extra que pida el estilo de landing. */
  fontHref?: string;
}

const tenant = Astro.locals.tenant;

const {
  title = `${tenant.businessName} | Electricistas Profesionales en Miami`,
  description = `Servicios eléctricos profesionales residenciales, comerciales y de emergencia 24/7 en Miami, Florida. Electricistas licenciados y certificados.`,
  image = "/images/og-image.jpg",
  keywords = "electricista miami, servicios electricos, emergencia 24/7, electricista residencial, electricista comercial",
  robots = "index, follow",
  extraStyleCss,
  fontHref,
} = Astro.props;

const siteUrl = `https://${Astro.url.hostname}`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageFull = image.startsWith('http') ? image : `${siteUrl}${image}`;
const palette = getPalette(tenant.palettePreset);
---

<!DOCTYPE html>
<html class="scroll-smooth" lang={Astro.locals.locale}>
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="robots" content={robots} />
  <meta name="author" content={tenant.businessName} />
  <meta name="theme-color" content={palette.deepNavy} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageFull} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={Astro.locals.locale === 'en' ? 'en_US' : 'es_US'} />
  <meta property="og:site_name" content={tenant.businessName} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImageFull} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />

  <!-- Google Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet"/>
  {fontHref && <link href={fontHref} rel="stylesheet" />}
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&icon_names=arrow_back,arrow_forward,bolt,business,calendar_today,call,chat,check,check_circle,close,description,elevator,emergency_home,engineering,ev_station,home,info,lightbulb,location_on,lock,mail,menu,payments,person_search,priority_high,schedule,search,shield_with_heart,star,support_agent,troubleshoot,verified_user,warning,workspace_premium&display=swap" rel="stylesheet"/>

  <!-- LocalBusiness Schema.org Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Electrician",
    "name": tenant.businessName,
    "description": description,
    "image": ogImageFull,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": tenant.address,
      "addressCountry": "US"
    },
    "telephone": tenant.phone,
    "email": tenant.email,
    "url": siteUrl,
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "07:00",
        "closes": "19:00"
      }
    ],
    "priceRange": "$$",
    "sameAs": Object.values(tenant.socialLinks)
  })} />

  <!-- Paleta del tenant: sobreescribe los defaults de @theme en global.css -->
  <style set:html={palette.css} />
  {extraStyleCss && <style set:html={extraStyleCss} />}
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex flex-col">
  <slot />
</body>
</html>
