---
import Layout from '../layouts/Layout.astro';
import homeHeroImage from '../assets/home-hero.jpg';
import serviceAreaImage from '../assets/service-area.jpg';
import { getLandingCopy } from '../lib/landingCopy';
import { getLandingStyle, resolveStyleId } from '../lib/landingStyles';
import RevealScript from '../components/landing/RevealScript.astro';

import HeroOverlay from '../components/landing/hero/Overlay.astro';
import HeroSplit from '../components/landing/hero/Split.astro';
import HeroCentered from '../components/landing/hero/Centered.astro';
import FeaturesGrid from '../components/landing/features/Grid.astro';
import FeaturesBento from '../components/landing/features/Bento.astro';
import FeaturesList from '../components/landing/features/List.astro';
import ServicesCards from '../components/landing/services/Cards.astro';
import ServicesFlat from '../components/landing/services/Flat.astro';
import ServicesStacked from '../components/landing/services/Stacked.astro';
import TestimonialsCarousel from '../components/landing/testimonials/Carousel.astro';
import TestimonialsGrid from '../components/landing/testimonials/Grid.astro';
import TestimonialsQuotes from '../components/landing/testimonials/Quotes.astro';
import ServiceAreaSplit from '../components/landing/serviceArea/Split.astro';
import ServiceAreaOverlay from '../components/landing/serviceArea/Overlay.astro';
import ServiceAreaStack from '../components/landing/serviceArea/Stack.astro';
import FinalCtaGradient from '../components/landing/finalCta/Gradient.astro';
import FinalCtaSolid from '../components/landing/finalCta/Solid.astro';
import FinalCtaCard from '../components/landing/finalCta/Card.astro';

const HERO_VARIANTS = { overlay: HeroOverlay, split: HeroSplit, centered: HeroCentered };
const FEATURES_VARIANTS = { grid: FeaturesGrid, bento: FeaturesBento, list: FeaturesList };
const SERVICES_VARIANTS = { cards: ServicesCards, flat: ServicesFlat, stacked: ServicesStacked };
const TESTIMONIALS_VARIANTS = { carousel: TestimonialsCarousel, grid: TestimonialsGrid, quotes: TestimonialsQuotes };
const SERVICE_AREA_VARIANTS = { split: ServiceAreaSplit, overlay: ServiceAreaOverlay, stack: ServiceAreaStack };
const FINAL_CTA_VARIANTS = { gradient: FinalCtaGradient, solid: FinalCtaSolid, card: FinalCtaCard };

const tenant = Astro.locals.tenant;
const locale = Astro.locals.locale;
const copy = getLandingCopy(tenant, locale);

// `?style=` permite enseñar los estilos sobre el contenido real del tenant sin
// guardar nada. Se valida contra el registro: nunca se confía en el query crudo.
const previewParam = Astro.url.searchParams.get('style');
const style = getLandingStyle(resolveStyleId(previewParam, tenant.stylePreset));
// Un preview no debe indexarse: serían N copias de la misma página.
const robots = previewParam ? 'noindex, nofollow' : 'index, follow';

const Hero = HERO_VARIANTS[style.sections.hero];
const Features = FEATURES_VARIANTS[style.sections.features];
const Services = SERVICES_VARIANTS[style.sections.services];
const Testimonials = TESTIMONIALS_VARIANTS[style.sections.testimonials];
const ServiceArea = SERVICE_AREA_VARIANTS[style.sections.serviceArea];
const FinalCta = FINAL_CTA_VARIANTS[style.sections.finalCta];
---

<Layout
  title={copy.title}
  description={copy.description}
  robots={robots}
  extraStyleCss={style.css}
  fontHref={style.fontHref}
>
  <div data-landing-style={style.id}>
    <Hero tenant={tenant} copy={copy} image={homeHeroImage} />
    <Features copy={copy} />
    <Services copy={copy} />
    <Testimonials tenant={tenant} copy={copy} locale={locale} />
    <ServiceArea tenant={tenant} copy={copy} image={serviceAreaImage} />
    <FinalCta tenant={tenant} copy={copy} />
  </div>
  <RevealScript />
</Layout>
