---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import aboutHeroImage from '../assets/about-hero.jpg';
import electricianProfessionalImage from '../assets/electrician-professional.jpg';
import certificationImage from '../assets/certification.jpg';

import { telHref } from '../lib/tenant';

const tenant = Astro.locals.tenant;
const locale = Astro.locals.locale;

const copy = {
  es: {
    title: `Sobre Nosotros | ${tenant.businessName}`,
    description: `${tenant.businessName} - Conozca más sobre nuestra empresa de servicios eléctricos en Miami, Florida. Licenciados y asegurados.`,
    heroTitle: `Sobre ${tenant.businessName}`,
    heroSubtitle: 'Su Socio Confiable en Servicios Eléctricos en Miami, Florida',
    storyHeading: 'Comprometidos con la Excelencia Eléctrica',
    story: [
      `Desde nuestra fundación en Miami, ${tenant.businessName} ha crecido basándose en la confianza y la calidad técnica superior. Nos enorgullecemos de ser un pilar en la comunidad, ofreciendo soluciones que van desde instalaciones residenciales meticulosas hasta complejos sistemas comerciales.`,
      'Nuestra trayectoria está marcada por un compromiso inquebrantable con la seguridad. Entendemos que cada conexión eléctrica es vital para el bienestar de su familia o la operatividad de su negocio, por lo que aplicamos los estándares más rigurosos del código eléctrico nacional.',
      'Contamos con un equipo de especialistas altamente capacitados que comparten una visión común: la excelencia en el servicio al cliente. Para nosotros, ningún trabajo es demasiado pequeño ni ningún proyecto demasiado complejo cuando se trata de garantizar la tranquilidad de nuestros clientes.',
    ],
    hqLine: 'Miami, FL — Sede Central Operativa',
    missionHeading: 'Nuestra Misión',
    mission: [
      'Proporcionar soluciones eléctricas integrales que garanticen la máxima seguridad, eficiencia energética y continuidad operativa para las familias y empresas de Miami, impulsando el progreso regional a través de la excelencia técnica.',
      'Buscamos transformar la industria eléctrica local mediante la innovación constante y un modelo de servicio centrado totalmente en la satisfacción y seguridad del cliente final.',
    ],
    valuesHeading: 'Nuestros Valores Fundamentales',
    values: [
      { icon: 'bolt', title: 'Seguridad Primero', body: 'Protocolos estrictos de protección para garantizar que cada instalación cumpla con los estándares de seguridad más altos.' },
      { icon: 'handshake', title: 'Integridad', body: 'Actuamos con honestidad y transparencia total en cada presupuesto, proceso y recomendación técnica.' },
      { icon: 'emoji_events', title: 'Excelencia', body: 'Buscamos la perfección en los detalles técnicos y estéticos de cada proyecto eléctrico que realizamos.' },
      { icon: 'diversity_3', title: 'Servicio al Cliente', body: 'Atención personalizada y empática, resolviendo sus necesidades con rapidez y profesionalismo.' },
      { icon: 'menu_book', title: 'Conocimiento Continuo', body: 'Inversión constante en capacitación sobre nuevas tecnologías eléctricas y normativas vigentes.' },
    ],
    whyChooseHeading: `Por Qué Los Clientes Eligen ${tenant.businessName}`,
    whyChooseBody: 'Con una calificación de 5.0 estrellas basada en reseñas de clientes satisfechos por nuestra dedicación y puntualidad.',
    whyChooseItems: ['Áreas de trabajo limpias', 'Precios claros y transparentes', 'Electricistas con licencia y seguro', 'Atención al cliente excepcional', 'Trabajos conforme a normativa'],
    credentialsHeading: 'Credenciales y Certificaciones',
    credentials: [
      'Tipo: Contratista Eléctrico Certificado',
      'Licencia Estatal: #EC1300XXXX',
      'Seguro: Full Liability & Workers Comp',
      'Área: Condado Miami-Dade y Alrededores',
      'Horario: Lunes a Viernes 8am - 6pm',
      'Emergencias: Soporte Crítico 24/7',
    ],
    stormBoxTitle: 'Seguridad ante Tormentas en Florida',
    stormBoxBody: 'Debido a la alta incidencia de rayos en Florida, recomendamos auditorías anuales en sistemas de puesta a tierra. Nuestros técnicos están especializados en protección contra sobretensiones climáticas.',
    communityHeading: 'Sirviendo a la Comunidad de Miami',
    communityBody1: 'Nuestra presencia se extiende a lo largo de las comunidades más vibrantes del sur de Florida. Estamos orgullosos de haber iluminado hogares y potenciado negocios locales durante más de una década.',
    communityBody2: `Desde la histórica Coral Gables hasta el moderno horizonte de Brickell, ${tenant.businessName} es sinónimo de confiabilidad regional.`,
    finalCtaHeading: '¿Quiere saber más sobre nuestros servicios o necesita una cotización personalizada?',
    finalCtaBody: 'Nuestro equipo está listo para asesorarlo en su próximo gran proyecto eléctrico.',
    callNow: 'Llamar Ahora',
    sendMessage: 'Enviar Mensaje',
    requestQuote: 'Solicitar Presupuesto',
  },
  en: {
    title: `About Us | ${tenant.businessName}`,
    description: `${tenant.businessName} - Learn more about our electrical services company in Miami, Florida. Licensed and insured.`,
    heroTitle: `About ${tenant.businessName}`,
    heroSubtitle: 'Your Trusted Partner for Electrical Services in Miami, Florida',
    storyHeading: 'Committed to Electrical Excellence',
    story: [
      `Since our founding in Miami, ${tenant.businessName} has grown on a foundation of trust and superior technical quality. We take pride in being a pillar of the community, offering solutions ranging from meticulous residential installations to complex commercial systems.`,
      'Our track record is defined by an unwavering commitment to safety. We understand that every electrical connection is vital to the well-being of your family or the operation of your business, which is why we apply the strictest standards of the national electrical code.',
      'We have a team of highly trained specialists who share a common vision: excellence in customer service. For us, no job is too small and no project too complex when it comes to ensuring our clients peace of mind.',
    ],
    hqLine: 'Miami, FL — Main Operating Headquarters',
    missionHeading: 'Our Mission',
    mission: [
      "To provide comprehensive electrical solutions that guarantee maximum safety, energy efficiency, and operational continuity for Miami's families and businesses, driving regional progress through technical excellence.",
      'We aim to transform the local electrical industry through constant innovation and a service model fully focused on the satisfaction and safety of the end client.',
    ],
    valuesHeading: 'Our Core Values',
    values: [
      { icon: 'bolt', title: 'Safety First', body: 'Strict protection protocols to ensure every installation meets the highest safety standards.' },
      { icon: 'handshake', title: 'Integrity', body: 'We act with complete honesty and transparency in every quote, process, and technical recommendation.' },
      { icon: 'emoji_events', title: 'Excellence', body: 'We pursue perfection in the technical and aesthetic details of every electrical project we undertake.' },
      { icon: 'diversity_3', title: 'Customer Service', body: 'Personalized, empathetic attention, resolving your needs with speed and professionalism.' },
      { icon: 'menu_book', title: 'Continuous Learning', body: 'Ongoing investment in training on new electrical technologies and current regulations.' },
    ],
    whyChooseHeading: `Why Clients Choose ${tenant.businessName}`,
    whyChooseBody: 'Rated 5.0 stars based on reviews from satisfied clients recognizing our dedication and punctuality.',
    whyChooseItems: ['Clean work areas', 'Clear, transparent pricing', 'Licensed and insured electricians', 'Exceptional customer service', 'Code-compliant work'],
    credentialsHeading: 'Credentials & Certifications',
    credentials: [
      'Type: Certified Electrical Contractor',
      'State License: #EC1300XXXX',
      'Insurance: Full Liability & Workers Comp',
      'Area: Miami-Dade County and Surrounding Areas',
      'Hours: Monday to Friday 8am - 6pm',
      'Emergencies: 24/7 Critical Support',
    ],
    stormBoxTitle: 'Storm Safety in Florida',
    stormBoxBody: "Due to Florida's high incidence of lightning strikes, we recommend annual audits of grounding systems. Our technicians specialize in protection against weather-related power surges.",
    communityHeading: 'Serving the Miami Community',
    communityBody1: 'Our presence extends across the most vibrant communities in South Florida. We are proud to have lit up homes and powered local businesses for over a decade.',
    communityBody2: `From historic Coral Gables to the modern Brickell skyline, ${tenant.businessName} is synonymous with regional reliability.`,
    finalCtaHeading: 'Want to learn more about our services or need a personalized quote?',
    finalCtaBody: 'Our team is ready to advise you on your next big electrical project.',
    callNow: 'Call Now',
    sendMessage: 'Send Message',
    requestQuote: 'Request a Quote',
  },
}[locale];

const title = copy.title;
const description = copy.description;
---

<Layout title={title} description={description}>
  <!-- Header Section -->
  <section class="relative py-[120px] flex items-center justify-center overflow-hidden pt-32">
    <div class="absolute inset-0 z-0">
      <Image 
        src={aboutHeroImage} 
        alt={`Equipo de ${tenant.businessName} en oficinas de Miami`}
        class="w-full h-full object-cover" 
        loading="eager" 
        fetchpriority="high"
        width={1920}
        height={400}
      />
      <div class="absolute inset-0 bg-primary/60 backdrop-blur-[2px]"></div>
    </div>
    <div class="relative z-10 text-center px-margin-mobile md:px-margin-desktop max-w-4xl mx-auto">
      <h1 class="font-display-lg text-white text-display-lg-mobile md:text-[56px] font-bold leading-tight mb-4">{copy.heroTitle}</h1>
      <p class="text-white font-body-md text-body-xl">{copy.heroSubtitle}</p>
    </div>
  </section>

  <!-- Sección: Nuestra Historia -->
  <section class="py-[100px] px-margin-mobile md:px-margin-desktop bg-white">
    <div class="max-w-container-max mx-auto grid md:grid-cols-2 gap-16 items-center">
      <div class="w-full h-[500px] rounded-xl overflow-hidden shadow-2xl">
        <Image 
          src={electricianProfessionalImage} 
          alt={`Electricista Profesional de ${tenant.businessName} trabajando`}
          class="w-full h-full object-cover" 
          loading="lazy"
          decoding="async"
          width={800}
          height={500}
        />
      </div>
      <div class="space-y-8">
        <h2 class="font-headline-lg text-headline-custom text-deep-navy">{copy.storyHeading}</h2>
        <div class="space-y-6 text-on-surface-variant leading-[1.8] font-body-md text-base">
          {copy.story.map((paragraph) => <p>{paragraph}</p>)}
          <p class="pt-4 text-deep-navy">
            <strong class="font-bold">{copy.hqLine}</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección: Nuestra Misión -->
  <section class="py-[100px] bg-brand-light-gray">
    <div class="max-w-[800px] mx-auto text-center px-margin-mobile">
      <div class="flex justify-center mb-10">
        <span class="material-symbols-outlined text-[100px] text-electric-blue" style="font-variation-settings: 'FILL' 1;">stars</span>
      </div>
      <h2 class="font-headline-lg text-headline-xl text-deep-navy mb-8">{copy.missionHeading}</h2>
      <div class="space-y-6 text-on-surface-variant text-body-lg">
        {copy.mission.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- Sección: Nuestros Valores -->
  <section class="py-[100px] bg-white px-margin-mobile">
    <div class="max-w-container-max mx-auto">
      <h2 class="font-headline-lg text-headline-xl text-deep-navy text-center mb-16">{copy.valuesHeading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        {copy.values.slice(0, 3).map((value) => (
          <div class="bg-brand-card-gray p-10 rounded-2xl border border-outline-variant/30 text-center hover:shadow-xl transition-all duration-300 group">
            <span class="material-symbols-outlined text-[70px] text-electric-blue mb-6 group-hover:scale-110 transition-transform">{value.icon}</span>
            <h3 class="font-headline-md text-deep-navy mb-4">{value.title}</h3>
            <p class="text-on-surface-variant">{value.body}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {copy.values.slice(3).map((value) => (
          <div class="bg-brand-card-gray p-10 rounded-2xl border border-outline-variant/30 text-center hover:shadow-xl transition-all duration-300 group">
            <span class="material-symbols-outlined text-[70px] text-electric-blue mb-6 group-hover:scale-110 transition-transform">{value.icon}</span>
            <h3 class="font-headline-md text-deep-navy mb-4">{value.title}</h3>
            <p class="text-on-surface-variant">{value.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sección: Por Qué Elegirnos -->
  <section class="py-[100px] bg-electric-blue text-white px-margin-mobile">
    <div class="max-w-container-max mx-auto text-center">
      <h2 class="font-headline-lg text-headline-xl mb-6">{copy.whyChooseHeading}</h2>
      <p class="font-body-md text-body-lg mb-16 opacity-90">{copy.whyChooseBody}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {copy.whyChooseItems.map((item) => (
          <div class="bg-brand-dark-blue p-8 rounded-xl border border-white/10 flex flex-col items-center justify-center space-y-4 shadow-lg hover:bg-brand-dark-blue/80 transition-colors">
            <span class="material-symbols-outlined text-success-green text-3xl font-bold">check_circle</span>
            <span class="font-bold">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sección: Nuestras Credenciales -->
  <section id="credenciales" class="py-[100px] bg-white px-margin-mobile">
    <div class="max-w-container-max mx-auto grid lg:grid-cols-[1.5fr_1fr] gap-16 items-start">
      <div class="space-y-10">
        <h2 class="font-headline-lg text-headline-custom text-deep-navy">{copy.credentialsHeading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
          {copy.credentials.map((item) => (
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
              <span class="font-body-md text-on-surface-variant font-semibold">{item}</span>
            </div>
          ))}
        </div>
        <!-- Highlighted Box -->
        <div class="bg-[#FFF9E6] p-8 rounded-xl border border-safety-yellow/30 flex gap-6 items-start">
          <span class="material-symbols-outlined text-safety-yellow text-4xl" style="font-variation-settings: 'FILL' 1;">warning</span>
          <div class="space-y-2">
            <p class="font-bold text-deep-navy">{copy.stormBoxTitle}</p>
            <p class="text-on-surface-variant text-sm">{copy.stormBoxBody}</p>
          </div>
        </div>
      </div>
      <div class="flex justify-center">
        <div class="w-full max-w-[400px] h-[400px] bg-surface-container rounded-2xl overflow-hidden shadow-lg border-8 border-white">
          <Image 
            src={certificationImage} 
            alt={`Certificación oficial de ${tenant.businessName} en Florida`}
            class="w-full h-full object-cover opacity-80 grayscale hover:grayscale-0 transition-all" 
            loading="lazy"
            decoding="async"
            width={400}
            height={400}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Sección: Compromiso con la Comunidad -->
  <section class="py-[100px] bg-brand-light-gray px-margin-mobile">
    <div class="max-w-container-max mx-auto text-center">
      <h2 class="font-headline-lg text-headline-xl text-deep-navy mb-8">{copy.communityHeading}</h2>
      <div class="max-w-[800px] mx-auto space-y-6 text-on-surface-variant text-body-lg mb-16">
        <p>{copy.communityBody1}</p>
        <p>{copy.communityBody2}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Coral Gables</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Brickell</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Doral</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Miami Beach</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Aventura</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Coconut Grove</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Pinecrest</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Key Biscayne</span>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center gap-3 border border-outline-variant/20">
          <span class="material-symbols-outlined text-electric-blue font-bold">check</span>
          <span class="font-bold text-deep-navy">Hialeah</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección: CTA Final -->
  <section class="py-[100px] bg-gradient-to-r from-deep-navy to-electric-blue text-white px-margin-mobile">
    <div class="max-w-4xl mx-auto text-center space-y-10">
      <h2 class="font-headline-lg text-headline-xl leading-tight">{copy.finalCtaHeading}</h2>
      <p class="text-xl opacity-90 font-body-md">{copy.finalCtaBody}</p>
      <div class="flex flex-wrap justify-center gap-6">
        <a class="bg-safety-yellow text-deep-navy px-10 py-5 rounded-lg font-bold text-lg hover:brightness-110 transition-all flex items-center gap-3 shadow-lg" href={telHref(tenant.phone)}>
          <span class="material-symbols-outlined">call</span>
          {copy.callNow}
        </a>
        <a class="bg-white text-electric-blue px-10 py-5 rounded-lg font-bold text-lg hover:bg-surface-bright transition-all flex items-center gap-3 shadow-lg" href="/contacto">
          <span class="material-symbols-outlined">mail</span>
          {copy.sendMessage}
        </a>
        <a class="bg-transparent border-2 border-white text-white px-10 py-5 rounded-lg font-bold text-lg hover:bg-white/10 transition-all flex items-center gap-3" href="/contacto">
          <span class="material-symbols-outlined">request_quote</span>
          {copy.requestQuote}
        </a>
      </div>
    </div>
  </section>

  <script>
    // Add intersection observer for reveal animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100');
          entry.target.classList.remove('opacity-0', 'translate-y-10');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('section').forEach(section => {
      section.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-10');
      observer.observe(section);
    });
  </script>
</Layout>
