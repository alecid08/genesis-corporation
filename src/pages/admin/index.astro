---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/Button.astro';
import { listTenants } from '../../lib/db';
import { env } from 'cloudflare:workers';
import { formatPhoneDisplay } from '../../lib/tenant';
import { tenantHost } from '../../lib/domains';

const tenants = env.DB ? await listTenants(env.DB) : [];
---

<AdminLayout title="Tenants">
  <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-6">Tenants</h1>

  {!env.DB && (
    <div class="bg-white p-6 rounded-xl shadow-sm border border-outline-variant mb-6">
      <p class="font-semibold text-deep-navy">No hay binding D1 disponible.</p>
      <p class="text-label-md text-outline mt-1">Corré con <code>wrangler dev</code> o desplegado en Cloudflare para ver datos reales.</p>
    </div>
  )}

  {env.DB && tenants.length === 0 && (
    <div class="bg-white p-6 rounded-xl shadow-sm border border-outline-variant mb-6">
      <p class="text-body-md">Todavía no hay tenants. <a class="text-electric-blue font-semibold hover:text-deep-navy" href="/admin/tenants/new">Creá el primero</a>.</p>
    </div>
  )}

  {tenants.length > 0 && (
    <div class="bg-white rounded-xl shadow-sm border border-outline-variant overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="bg-surface-container">
            <th class="text-left py-3 px-4 text-label-md font-semibold text-deep-navy">Negocio</th>
            <th class="text-left py-3 px-4 text-label-md font-semibold text-deep-navy">Subdominio</th>
            <th class="text-left py-3 px-4 text-label-md font-semibold text-deep-navy">Teléfono</th>
            <th class="text-left py-3 px-4 text-label-md font-semibold text-deep-navy">Estado</th>
            <th class="py-3 px-4"></th>
          </tr>
        </thead>
        <tbody>
          {tenants.map((t) => (
            <tr class="border-t border-outline-variant">
              <td class="py-3 px-4 text-body-md">{t.businessName}</td>
              <td class="py-3 px-4 text-body-md">{tenantHost(t.slug)}</td>
              <td class="py-3 px-4 text-body-md">{formatPhoneDisplay(t.phone)}</td>
              <td class="py-3 px-4">
                <span class={`inline-block px-3 py-0.5 rounded-full text-label-md font-semibold ${t.status === 'live' ? 'bg-success-green/15 text-success-green' : 'bg-tertiary-container/25 text-tertiary'}`}>
                  {t.status}
                </span>
              </td>
              <td class="py-3 px-4 text-right">
                <Button text="Editar" href={`/admin/tenants/${t.slug}`} variant="outline" size="small" />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
