---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getTenantForAdmin, updateTenant, setTenantAssetKey, addTestimonial, deleteTestimonial } from '../../../lib/db';
import { uploadTenantAsset } from '../../../lib/r2';
import { normalizePhoneToE164, formatPhoneDisplay } from '../../../lib/tenant';
import { PALETTE_PRESETS } from '../../../lib/palettes';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
let error: string | null = null;
let notice: string | null = null;

if (!env.DB || !slug) {
  return new Response('Not found', { status: 404 });
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const current = await getTenantForAdmin(env.DB, slug);

  if (!current) {
    return new Response('Not found', { status: 404 });
  }

  if (action === 'update-tenant') {
    const businessName = String(form.get('business_name') ?? '').trim();
    const phoneRaw = String(form.get('phone') ?? '').trim();
    const email = String(form.get('email') ?? '').trim();
    const address = String(form.get('address') ?? '').trim();
    const googlePlaceId = String(form.get('google_place_id') ?? '').trim();
    const palettePreset = String(form.get('palette_preset') ?? PALETTE_PRESETS[0]);
    const facebook = String(form.get('facebook') ?? '').trim();
    const instagram = String(form.get('instagram') ?? '').trim();
    const localeDefault = form.get('locale_default') === 'en' ? 'en' : 'es';
    const status = form.get('status') === 'live' ? 'live' : 'draft';
    const phone = normalizePhoneToE164(phoneRaw);

    if (!businessName || !email || !address) {
      error = 'Nombre, email y dirección son obligatorios.';
    } else if (!phone) {
      error = 'Teléfono inválido. Usá un número de EE.UU. de 10 dígitos.';
    } else {
      const socialLinks: Record<string, string> = {};
      if (facebook) socialLinks.facebook = facebook;
      if (instagram) socialLinks.instagram = instagram;

      await updateTenant(env.DB, current.id, {
        slug: current.slug,
        businessName,
        phone,
        email,
        address,
        googlePlaceId: googlePlaceId || undefined,
        palettePreset,
        socialLinks,
        localeDefault,
        status,
      });
      notice = 'Cambios guardados.';
    }
  }

  if ((action === 'upload-logo' || action === 'upload-hero') && env.TENANT_ASSETS) {
    const file = form.get(action === 'upload-logo' ? 'logo' : 'hero');
    if (file instanceof File && file.size > 0) {
      const key = await uploadTenantAsset(env.TENANT_ASSETS, current.slug, action === 'upload-logo' ? 'logo' : 'hero', file);
      await setTenantAssetKey(env.DB, current.id, action === 'upload-logo' ? 'logo_r2_key' : 'hero_r2_key', key);
      notice = 'Imagen actualizada.';
    }
  }

  if (action === 'add-testimonial') {
    const author = String(form.get('author') ?? '').trim();
    const location = String(form.get('location') ?? '').trim();
    const rating = Number(form.get('rating') ?? 5);
    const quoteEs = String(form.get('quote_es') ?? '').trim();
    const quoteEn = String(form.get('quote_en') ?? '').trim();

    if (!author || !location || !quoteEs) {
      error = 'Autor, ubicación y reseña (español) son obligatorios.';
    } else {
      await addTestimonial(env.DB, current.id, {
        author,
        location,
        rating: Math.min(5, Math.max(1, rating)),
        quoteEs,
        quoteEn: quoteEn || undefined,
        sortOrder: current.adminTestimonials.length + 1,
      });
      notice = 'Reseña agregada.';
    }
  }

  if (action === 'delete-testimonial') {
    const testimonialId = Number(form.get('testimonial_id'));
    if (testimonialId) {
      await deleteTestimonial(env.DB, testimonialId, current.id);
      notice = 'Reseña eliminada.';
    }
  }
}

const tenant = await getTenantForAdmin(env.DB, slug);
if (!tenant) {
  return new Response('Not found', { status: 404 });
}
---

<AdminLayout title={tenant.businessName}>
  <h1>{tenant.businessName}</h1>
  <p class="hint">
    <a href={`https://${tenant.slug}.demos.ladetec.com`} target="_blank">https://{tenant.slug}.demos.ladetec.com</a>
    · <span class={`badge ${tenant.status === 'live' ? 'badge-live' : 'badge-draft'}`}>{tenant.status}</span>
  </p>

  {notice && <div class="flash">{notice}</div>}
  {error && <div class="card" style="background:#ffdad6;color:#93000a;">{error}</div>}

  <form class="card" method="POST">
    <input type="hidden" name="_action" value="update-tenant" />
    <label for="business_name">Nombre del negocio *</label>
    <input id="business_name" name="business_name" required value={tenant.businessName} />

    <div class="row">
      <div>
        <label for="phone">Teléfono *</label>
        <input id="phone" name="phone" required value={formatPhoneDisplay(tenant.phone)} />
      </div>
      <div>
        <label for="email">Email *</label>
        <input id="email" name="email" type="email" required value={tenant.email} />
      </div>
    </div>

    <label for="address">Dirección *</label>
    <input id="address" name="address" required value={tenant.address} />

    <label for="google_place_id">Google Place ID (opcional, referencia)</label>
    <input id="google_place_id" name="google_place_id" />

    <label for="palette_preset">Paleta</label>
    <select id="palette_preset" name="palette_preset">
      {PALETTE_PRESETS.map((p) => <option value={p} selected={p === tenant.palettePreset}>{p}</option>)}
    </select>

    <div class="row">
      <div>
        <label for="facebook">Facebook (opcional)</label>
        <input id="facebook" name="facebook" value={tenant.socialLinks.facebook ?? ''} />
      </div>
      <div>
        <label for="instagram">Instagram (opcional)</label>
        <input id="instagram" name="instagram" value={tenant.socialLinks.instagram ?? ''} />
      </div>
    </div>

    <div class="row">
      <div>
        <label for="locale_default">Idioma por defecto</label>
        <select id="locale_default" name="locale_default">
          <option value="es" selected={tenant.localeDefault === 'es'}>Español</option>
          <option value="en" selected={tenant.localeDefault === 'en'}>English</option>
        </select>
      </div>
      <div>
        <label for="status">Estado</label>
        <select id="status" name="status">
          <option value="draft" selected={tenant.status === 'draft'}>Borrador</option>
          <option value="live" selected={tenant.status === 'live'}>Publicado</option>
        </select>
      </div>
    </div>

    <div class="actions">
      <button class="btn" type="submit">Guardar Cambios</button>
    </div>
  </form>

  <div class="card">
    <h3 style="margin-top:0;">Logo</h3>
    {tenant.logoR2Key && <p><img src={`/assets/${tenant.logoR2Key}`} alt="Logo actual" style="max-height:60px;" /></p>}
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_action" value="upload-logo" />
      <input type="file" name="logo" accept="image/*" required />
      <div class="actions"><button class="btn btn-secondary" type="submit">Subir Logo</button></div>
    </form>

    <h3>Imagen Hero</h3>
    {tenant.heroR2Key && <p><img src={`/assets/${tenant.heroR2Key}`} alt="Hero actual" style="max-height:120px;" /></p>}
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_action" value="upload-hero" />
      <input type="file" name="hero" accept="image/*" required />
      <div class="actions"><button class="btn btn-secondary" type="submit">Subir Hero</button></div>
    </form>
  </div>

  <div class="card">
    <h3 style="margin-top:0;">Reseñas (copiadas de Google Places)</h3>
    {tenant.adminTestimonials.map((t) => (
      <div style="border-top:1px solid #e0e3e6; padding:12px 0;">
        <strong>{t.author}</strong> — {t.location} ({t.rating}★)
        <p style="margin:6px 0;">{t.quoteEs}</p>
        <form method="POST" style="display:inline;">
          <input type="hidden" name="_action" value="delete-testimonial" />
          <input type="hidden" name="testimonial_id" value={t.id} />
          <button class="btn btn-danger" type="submit" style="padding:6px 12px;font-size:12px;">Eliminar</button>
        </form>
      </div>
    ))}

    <h4>Agregar reseña</h4>
    <form method="POST">
      <input type="hidden" name="_action" value="add-testimonial" />
      <div class="row">
        <div>
          <label for="author">Autor *</label>
          <input id="author" name="author" required placeholder="Juan P." />
        </div>
        <div>
          <label for="location">Ubicación *</label>
          <input id="location" name="location" required placeholder="Miami, FL" />
        </div>
      </div>
      <label for="rating">Rating (1-5)</label>
      <input id="rating" name="rating" type="number" min="1" max="5" value="5" />
      <label for="quote_es">Reseña (Español) *</label>
      <textarea id="quote_es" name="quote_es" rows="3" required></textarea>
      <label for="quote_en">Reseña (English, opcional)</label>
      <textarea id="quote_en" name="quote_en" rows="3"></textarea>
      <div class="actions">
        <button class="btn" type="submit">Agregar Reseña</button>
      </div>
    </form>
  </div>
</AdminLayout>
