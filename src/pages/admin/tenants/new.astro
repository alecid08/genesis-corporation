---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/Button.astro';
import SubmitButton from '../../../components/SubmitButton.astro';
import { createTenant } from '../../../lib/db';
import { normalizePhoneToE164 } from '../../../lib/tenant';
import { PALETTE_PRESETS } from '../../../lib/palettes';
import { LANDING_STYLE_OPTIONS, DEFAULT_LANDING_STYLE, resolveStyleId } from '../../../lib/landingStyles';
import { env } from 'cloudflare:workers';

let error: string | null = null;

if (Astro.request.method === 'POST' && env.DB) {
  const form = await Astro.request.formData();
  const slug = String(form.get('slug') ?? '').trim().toLowerCase();
  const businessName = String(form.get('business_name') ?? '').trim();
  const phoneRaw = String(form.get('phone') ?? '').trim();
  const email = String(form.get('email') ?? '').trim();
  const address = String(form.get('address') ?? '').trim();
  const googlePlaceId = String(form.get('google_place_id') ?? '').trim();
  const palettePreset = String(form.get('palette_preset') ?? PALETTE_PRESETS[0]);
  const stylePreset = resolveStyleId(String(form.get('style_preset') ?? ''), DEFAULT_LANDING_STYLE);
  const facebook = String(form.get('facebook') ?? '').trim();
  const instagram = String(form.get('instagram') ?? '').trim();
  const localeDefault = form.get('locale_default') === 'en' ? 'en' : 'es';
  const status = form.get('status') === 'live' ? 'live' : 'draft';

  const phone = normalizePhoneToE164(phoneRaw);

  if (!/^[a-z0-9-]+$/.test(slug)) {
    error = 'El subdominio solo puede tener minúsculas, números y guiones.';
  } else if (!businessName || !email || !address) {
    error = 'Nombre, email y dirección son obligatorios.';
  } else if (!phone) {
    error = 'Teléfono inválido. Usá un número de EE.UU. de 10 dígitos.';
  } else {
    const socialLinks: Record<string, string> = {};
    if (facebook) socialLinks.facebook = facebook;
    if (instagram) socialLinks.instagram = instagram;

    try {
      await createTenant(env.DB, {
        slug,
        businessName,
        phone,
        email,
        address,
        googlePlaceId: googlePlaceId || undefined,
        palettePreset,
        stylePreset,
        socialLinks,
        localeDefault,
        status,
      });
      return Astro.redirect(`/admin/tenants/${slug}`);
    } catch (e) {
      error = `No se pudo crear (¿el subdominio ya existe?): ${(e as Error).message}`;
    }
  }
}

const inputClass = "w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md";
const labelClass = "font-label-lg text-deep-navy block font-semibold mb-2";
---

<AdminLayout title="Nuevo tenant">
  <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-6">Nuevo Tenant</h1>

  {error && (
    <div class="p-4 bg-error-container text-on-error-container rounded-lg text-sm font-medium mb-6">{error}</div>
  )}

  <form class="bg-white p-8 rounded-xl shadow-sm border border-outline-variant space-y-6" method="POST">
    <div>
      <label class={labelClass} for="business_name">Nombre del negocio *</label>
      <input class={inputClass} id="business_name" name="business_name" required placeholder="Acme Electric LLC" />
    </div>

    <div>
      <label class={labelClass} for="slug">Subdominio *</label>
      <input class={inputClass} id="slug" name="slug" required pattern="[a-z0-9-]+" placeholder="acme-electric" />
      <p class="text-label-md text-outline mt-2">Quedará en https://&lt;subdominio&gt;.tacocars.com</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class={labelClass} for="phone">Teléfono *</label>
        <input class={inputClass} id="phone" name="phone" required placeholder="(305) 555-1234" />
      </div>
      <div>
        <label class={labelClass} for="email">Email *</label>
        <input class={inputClass} id="email" name="email" type="email" required placeholder="contacto@negocio.com" />
      </div>
    </div>

    <div>
      <label class={labelClass} for="address">Dirección *</label>
      <input class={inputClass} id="address" name="address" required placeholder="123 Main St, Miami, FL 33125" />
    </div>

    <div>
      <label class={labelClass} for="google_place_id">Google Place ID (opcional, referencia)</label>
      <input class={inputClass} id="google_place_id" name="google_place_id" placeholder="ChIJ..." />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class={labelClass} for="palette_preset">Paleta</label>
        <select class={inputClass} id="palette_preset" name="palette_preset">
          {PALETTE_PRESETS.map((p) => <option value={p}>{p}</option>)}
        </select>
      </div>
      <div>
        <label class={labelClass} for="style_preset">Estilo de la landing</label>
        <select class={inputClass} id="style_preset" name="style_preset">
          {LANDING_STYLE_OPTIONS.map((s) => <option value={s.id}>{s.label}</option>)}
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class={labelClass} for="facebook">Facebook (opcional)</label>
        <input class={inputClass} id="facebook" name="facebook" placeholder="https://facebook.com/..." />
      </div>
      <div>
        <label class={labelClass} for="instagram">Instagram (opcional)</label>
        <input class={inputClass} id="instagram" name="instagram" placeholder="https://instagram.com/..." />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class={labelClass} for="locale_default">Idioma por defecto</label>
        <select class={inputClass} id="locale_default" name="locale_default">
          <option value="es">Español</option>
          <option value="en">English</option>
        </select>
      </div>
      <div>
        <label class={labelClass} for="status">Estado</label>
        <select class={inputClass} id="status" name="status">
          <option value="draft">Borrador</option>
          <option value="live">Publicado</option>
        </select>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <SubmitButton text="Crear Tenant" />
      <Button text="Cancelar" href="/admin" variant="outline" />
    </div>
  </form>
</AdminLayout>
