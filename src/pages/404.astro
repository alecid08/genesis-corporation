---
import Layout from '../layouts/Layout.astro';

const tenant = Astro.locals.tenant;
const locale = Astro.locals.locale;

const copy = {
  es: {
    title: `Página no encontrada | ${tenant.businessName}`,
    heading: 'Página No Encontrada',
    body: 'La página que buscas no existe o fue movida.',
    backHome: 'Volver al Inicio',
  },
  en: {
    title: `Page Not Found | ${tenant.businessName}`,
    heading: 'Page Not Found',
    body: 'The page you are looking for does not exist or has been moved.',
    backHome: 'Back to Home',
  },
}[locale];
---

<Layout title={copy.title}>
  <main class="flex-grow flex items-center justify-center py-[150px] px-margin-mobile text-center">
    <div>
      <p class="font-display-lg text-[96px] font-bold text-electric-blue leading-none mb-4">404</p>
      <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-4">{copy.heading}</h1>
      <p class="text-on-surface-variant font-body-lg mb-10">{copy.body}</p>
      <a href="/" class="inline-block bg-safety-yellow text-deep-navy font-bold py-4 px-8 rounded-lg shadow-lg hover:brightness-95 transition-all">
        {copy.backHome}
      </a>
    </div>
  </main>
</Layout>
