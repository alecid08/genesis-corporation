---
import Layout from '../layouts/Layout.astro';
import { formatPhoneDisplay, telHref } from '../lib/tenant';

const tenant = Astro.locals.tenant;
const locale = Astro.locals.locale;

const copy = {
  es: {
    title: `¡Gracias! - ${tenant.businessName}`,
    description: 'Mensaje recibido con éxito. Nos pondremos en contacto con usted lo antes posible.',
    heading: '¡Gracias por Contactarnos!',
    body1: 'Hemos recibido su mensaje y nos pondremos en contacto con usted dentro de las próximas 24-48 horas.',
    body2Prefix: 'Si es una emergencia, por favor llámenos directamente al',
    highlightPrefix: '¿Necesita Atención Inmediata? Llámenos:',
    backHome: 'Volver al Inicio',
  },
  en: {
    title: `Thank You! - ${tenant.businessName}`,
    description: 'Message received successfully. We will get in touch with you as soon as possible.',
    heading: 'Thank You for Contacting Us!',
    body1: 'We have received your message and will get in touch with you within the next 24-48 hours.',
    body2Prefix: 'If this is an emergency, please call us directly at',
    highlightPrefix: 'Need Immediate Attention? Call Us:',
    backHome: 'Back to Home',
  },
}[locale];

const title = copy.title;
const description = copy.description;
---

<Layout title={title} description={description}>
  <style>
    .success-animation {
      animation: scaleIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    }
    @keyframes scaleIn {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
  </style>

  <!-- Main Success Content -->
  <main class="flex-grow flex items-center justify-center py-[150px] px-margin-mobile">
    <div class="w-full max-w-[700px] bg-white rounded-xl shadow-sm p-8 md:p-12 text-center flex flex-col items-center">
      <!-- Icon -->
      <div class="success-animation mb-8">
        <span class="material-symbols-outlined text-[120px] text-success-green" style="font-variation-settings: 'FILL' 1;">
          check_circle
        </span>
      </div>
      <!-- Heading -->
      <h1 class="font-display-lg text-[48px] leading-[1.2] font-bold text-deep-navy mb-8">
        {copy.heading}
      </h1>
      <!-- Body Text -->
      <div class="space-y-4 mb-10">
        <p class="font-body-lg text-[18px] text-on-surface-variant max-w-[550px]">
          {copy.body1}
        </p>
        <p class="font-body-lg text-[18px] text-on-surface-variant max-w-[550px]">
          {copy.body2Prefix} <span class="font-bold text-deep-navy">{formatPhoneDisplay(tenant.phone)}</span>.
        </p>
      </div>
      <!-- Highlight Box -->
      <div class="w-full bg-[#E3F2FD] p-8 rounded-[12px] border border-[#BBDEFB] mb-12">
        <p class="font-headline-md text-deep-navy text-xl md:text-2xl flex items-center justify-center gap-3">
          <span>📞</span>
          {copy.highlightPrefix}
          <a class="font-bold hover:underline" href={telHref(tenant.phone)}>{formatPhoneDisplay(tenant.phone)}</a>
        </p>
      </div>
      <!-- Button -->
      <a class="group inline-flex items-center gap-2 px-8 py-3 border-2 border-electric-blue text-electric-blue rounded-lg font-label-lg text-label-lg font-bold hover:bg-electric-blue/5 transition-all" href="/">
        <span class="material-symbols-outlined transition-transform group-hover:-translate-x-1">arrow_back</span>
        {copy.backHome}
      </a>
    </div>
  </main>
</Layout>
