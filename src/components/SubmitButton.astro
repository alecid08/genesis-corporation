---
import { BUTTON_VARIANT_CLASSES, BUTTON_SIZE_CLASSES, type ButtonVariant, type ButtonSize } from '../lib/buttonStyles';

interface Props {
  text: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  icon?: string;
  class?: string;
}

const {
  text,
  variant = 'secondary',
  size = 'medium',
  icon,
  class: className = '',
} = Astro.props;
---

<button
  type="submit"
  class={`inline-flex items-center justify-center gap-2 transition-all duration-200 text-center cursor-pointer ${BUTTON_VARIANT_CLASSES[variant]} ${BUTTON_SIZE_CLASSES[size]} ${className}`}
>
  {icon && (
    <span class="material-symbols-outlined select-none text-xl">{icon}</span>
  )}
  <span>{text}</span>
</button>
