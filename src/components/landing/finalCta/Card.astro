---
import { telHref } from '../../../lib/tenant';
import type { FinalCtaProps } from '../types';

const { tenant, copy } = Astro.props as FinalCtaProps;
---

<section class="py-section-y bg-surface-subtle">
  <div class="px-base md:px-margin-desktop max-w-container-max mx-auto">
    <div data-reveal class="max-w-4xl mx-auto text-center bg-card-surface border border-card-border rounded-card shadow-[var(--shadow-card)] px-8 py-16 md:px-16">
      <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-6">{copy.finalCta.heading}</h2>
      <p class="font-body-lg text-lg text-on-surface-variant mb-12 max-w-2xl mx-auto">{copy.finalCta.body}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a class="bg-electric-blue text-on-primary font-bold py-4 px-9 rounded-button hover:opacity-90 transition-all flex items-center gap-3" href={telHref(tenant.phone)}>
          <span class="material-symbols-outlined">call</span> {copy.finalCta.callNow}
        </a>
        <a class="bg-surface-subtle text-on-surface border border-card-border font-bold py-4 px-9 rounded-button hover:brightness-95 transition-all flex items-center gap-3" href="/contacto">
          <span class="material-symbols-outlined">chat</span> {copy.finalCta.sendMessage}
        </a>
        <a class="font-bold py-4 px-9 text-on-surface underline underline-offset-8 decoration-1 hover:opacity-70 transition-all flex items-center gap-3" href="/contacto">
          <span class="material-symbols-outlined">description</span> {copy.finalCta.requestQuote}
        </a>
      </div>
    </div>
  </div>
</section>
