---
import { telHref } from '../../../lib/tenant';
import type { FinalCtaProps } from '../types';

const { tenant, copy } = Astro.props as FinalCtaProps;
---

<section class="py-section-y bg-deep-navy text-on-primary">
  <div class="px-base md:px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <div class="w-24 h-1.5 bg-safety-yellow mb-8"></div>
        <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg [text-transform:var(--display-transform)] mb-6">{copy.finalCta.heading}</h2>
        <p class="font-body-lg text-lg opacity-90 max-w-2xl">{copy.finalCta.body}</p>
      </div>
      <div class="lg:col-span-5 flex flex-col gap-4">
        <a class="bg-safety-yellow text-deep-navy font-bold py-5 px-8 rounded-button tracking-wider [text-transform:var(--display-transform)] hover:brightness-95 transition-all flex items-center justify-center gap-3" href={telHref(tenant.phone)}>
          <span class="material-symbols-outlined">call</span> {copy.finalCta.callNow}
        </a>
        <a class="bg-white text-deep-navy font-bold py-5 px-8 rounded-button tracking-wider [text-transform:var(--display-transform)] hover:brightness-95 transition-all flex items-center justify-center gap-3" href="/contacto">
          <span class="material-symbols-outlined">chat</span> {copy.finalCta.sendMessage}
        </a>
        <a class="border-2 border-white text-white font-bold py-5 px-8 rounded-button tracking-wider [text-transform:var(--display-transform)] hover:bg-white/10 transition-all flex items-center justify-center gap-3" href="/contacto">
          <span class="material-symbols-outlined">description</span> {copy.finalCta.requestQuote}
        </a>
      </div>
    </div>
  </div>
</section>
