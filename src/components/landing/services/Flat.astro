---
import type { ServicesProps } from '../types';

const { copy } = Astro.props as ServicesProps;
---

<section class="py-section-y bg-card-surface">
  <div class="px-base md:px-margin-desktop max-w-container-max mx-auto">
    <h2 class="font-headline-lg text-headline-lg text-heading mb-16">{copy.services.heading}</h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
      {copy.services.items.map((service) => {
        const emergency = service.tone === 'emergency';
        return (
          <div
            data-reveal
            class:list={[
              'bg-surface-subtle border-l-8 rounded-card p-8 transition-all hover:-translate-y-1',
              emergency ? 'border-l-emergency-red' : 'border-l-accent',
            ]}
          >
            <div class="flex items-center gap-4 mb-8">
              <span
                class:list={['material-symbols-outlined text-5xl', emergency ? 'text-emergency-red' : 'text-accent']}
                style={emergency ? "font-variation-settings: 'FILL' 1;" : undefined}
              >{service.icon}</span>
              <h3 class:list={['font-headline-md text-headline-md [text-transform:var(--display-transform)]', emergency ? 'text-emergency-red' : 'text-on-surface']}>
                {service.title}
              </h3>
            </div>
            <ul class="divide-y divide-card-border">
              {service.items.map((item) => (
                <li class="flex items-start gap-3 py-4">
                  <span class:list={['material-symbols-outlined shrink-0', emergency ? 'text-emergency-red' : 'text-success-green']}>
                    {emergency ? 'emergency_home' : 'check'}
                  </span>
                  <span class="font-body-md text-on-surface-variant">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
