---
import { Image } from 'astro:assets';
import type { HeroProps } from '../types';

const { tenant, copy, image } = Astro.props as HeroProps;
---

<section class="grid grid-cols-1 lg:grid-cols-2 min-h-[640px]">
  <div class="order-2 lg:order-1 bg-deep-navy text-on-primary flex items-center">
    <div class="px-base md:px-margin-desktop py-16 lg:py-24 w-full">
      <p class="font-label-lg text-label-lg uppercase tracking-[0.24em] text-safety-yellow mb-6">
        {copy.hero.subtitle}
      </p>
      <h1 class="font-display-lg text-[clamp(40px,5.5vw,72px)] leading-[1.02] font-bold mb-8 [text-transform:var(--display-transform)]">
        {tenant.businessName}
      </h1>
      <div class="w-24 h-1.5 bg-safety-yellow mb-8"></div>
      <div class="flex flex-wrap gap-4">
        <a href="/servicios" class="bg-safety-yellow text-deep-navy font-bold py-4 px-8 rounded-button tracking-wider [text-transform:var(--display-transform)] hover:brightness-95 transition-all inline-block">
          {copy.hero.ctaServices}
        </a>
        <a href="/contacto" class="border-2 border-white text-white font-bold py-4 px-8 rounded-button tracking-wider [text-transform:var(--display-transform)] hover:bg-white/10 transition-all inline-block">
          {copy.hero.ctaQuote}
        </a>
      </div>
    </div>
  </div>
  <div class="order-1 lg:order-2 relative min-h-[320px] lg:min-h-full">
    <Image
      src={image}
      alt="Electricista profesional en Miami trabajando en un panel eléctrico moderno"
      class="w-full h-full object-cover absolute inset-0"
      loading="eager"
      fetchpriority="high"
      width={1920}
      height={1080}
    />
  </div>
</section>
