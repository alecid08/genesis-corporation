---
import { Image } from 'astro:assets';
import type { HeroProps } from '../types';

const { tenant, copy, image } = Astro.props as HeroProps;
---

<section class="relative h-[819px] flex items-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <Image
      src={image}
      alt="Electricista profesional en Miami trabajando en un panel eléctrico moderno"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width={1920}
      height={1080}
    />
    <div class="absolute inset-0 bg-primary/40 mix-blend-multiply"></div>
  </div>
  <div class="relative z-10 px-base md:px-margin-desktop max-w-container-max mx-auto w-full">
    <div class="max-w-2xl text-on-primary">
      <h1 class="font-display-lg text-[60px] leading-[1.1] font-bold mb-6">
        {tenant.businessName}
      </h1>
      <p class="font-headline-md text-headline-md mb-8 opacity-90">
        {copy.hero.subtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/servicios" class="bg-safety-yellow text-deep-navy font-bold py-4 px-8 rounded-lg shadow-lg hover:brightness-95 transition-all text-lg inline-block text-center">
          {copy.hero.ctaServices}
        </a>
        <a href="/contacto" class="bg-transparent border-2 border-white text-white font-bold py-4 px-8 rounded-lg hover:bg-white/10 transition-all text-lg inline-block text-center">
          {copy.hero.ctaQuote}
        </a>
      </div>
    </div>
  </div>
</section>
