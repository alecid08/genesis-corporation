---
import { formatPhoneDisplay, telHref } from '../lib/tenant';
import { t } from '../lib/i18n';

const tenant = Astro.locals.tenant;
const locale = Astro.locals.locale;
const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-navy dark:bg-black relative w-full pt-16 pb-8 border-t border-white/10 text-on-primary">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-gutter px-base md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Brand Info -->
    <div class="flex flex-col gap-6">
      <div class="font-display-lg text-headline-md font-bold text-on-primary">{tenant.businessName}</div>
      <p class="text-on-primary/80 font-body-md">
        {t(locale, 'footer', 'tagline')}
      </p>
      <div class="flex gap-4">
        {tenant.socialLinks.facebook && (
          <a class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-safety-yellow hover:text-deep-navy transition-all" href={tenant.socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Facebook">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M9 8H7v3h2v9h4v-9h3.6l.4-3H13V6c0-.5.5-1 1-1h2V2h-3a4 4 0 00-4 4v2z"/>
            </svg>
          </a>
        )}
        {tenant.socialLinks.instagram && (
          <a class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-safety-yellow hover:text-deep-navy transition-all" href={tenant.socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Instagram">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
    <!-- Quick Links -->
    <div class="flex flex-col gap-4">
      <h4 class="text-safety-yellow font-bold font-headline-md text-headline-md">{t(locale, 'footer', 'navHeading')}</h4>
      <ul class="flex flex-col gap-2">
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/">{t(locale, 'nav', 'home')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/servicios">{t(locale, 'nav', 'services')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/sobre-nosotros">{t(locale, 'nav', 'about')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/contacto">{t(locale, 'nav', 'contact')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/emergencia">{t(locale, 'nav', 'emergency')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/faq">{t(locale, 'nav', 'faq')}</a></li>
      </ul>
    </div>
    <!-- Services Links -->
    <div class="flex flex-col gap-4">
      <h4 class="text-safety-yellow font-bold font-headline-md text-headline-md">{t(locale, 'footer', 'servicesHeading')}</h4>
      <ul class="flex flex-col gap-2">
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/servicios#residencial">{t(locale, 'footer', 'residential')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/servicios#comercial">{t(locale, 'footer', 'commercial')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/emergencia">{t(locale, 'footer', 'emergencies')}</a></li>
        <li><a class="text-on-primary/80 hover:text-safety-yellow transition-colors hover:translate-x-1 inline-block font-body-md" href="/servicios#mantenimiento">{t(locale, 'footer', 'maintenance')}</a></li>
      </ul>
    </div>
    <!-- Contact Info -->
    <div class="flex flex-col gap-4">
      <h4 class="text-safety-yellow font-bold font-headline-md text-headline-md">{t(locale, 'footer', 'contactHeading')}</h4>
      <p class="flex items-start gap-3 text-on-primary/80 font-body-md">
        <span class="material-symbols-outlined text-safety-yellow">location_on</span>
        <span>{tenant.address}</span>
      </p>
      <p class="flex items-center gap-3 text-on-primary/80 font-body-md">
        <span class="material-symbols-outlined text-safety-yellow">call</span>
        <a href={telHref(tenant.phone)} class="hover:text-safety-yellow transition-colors">{formatPhoneDisplay(tenant.phone)}</a>
      </p>
      <p class="flex items-center gap-3 text-on-primary/80 font-body-md">
        <span class="material-symbols-outlined text-safety-yellow">mail</span>
        <a href={`mailto:${tenant.email}`} class="hover:text-safety-yellow transition-colors">{tenant.email}</a>
      </p>
    </div>
  </div>
  <div class="max-w-container-max mx-auto px-base md:px-margin-desktop mt-16 pt-8 border-t border-white/10 text-center">
    <p class="text-on-primary/85 font-label-md text-label-md">© {currentYear} {tenant.businessName}. {t(locale, 'footer', 'rightsReserved')}</p>
  </div>
</footer>
