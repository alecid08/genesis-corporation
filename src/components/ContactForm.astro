---
const locale = Astro.locals.locale;

const copy = {
  es: {
    heading: 'Envíenos un Mensaje',
    formError: 'Hubo un error al enviar el formulario. Por favor, revise los campos e inténtelo de nuevo.',
    name: 'Nombre *',
    namePlaceholder: 'Su nombre completo',
    phone: 'Teléfono *',
    email: 'Email *',
    emailPlaceholder: 'nombre@correo.com',
    serviceType: 'Tipo de Servicio',
    residential: 'Residencial',
    commercial: 'Comercial',
    emergency: 'Emergencia 24/7',
    address: 'Dirección del Proyecto',
    addressPlaceholder: 'Calle, Ciudad, Zip Code',
    message: 'Mensaje *',
    messagePlaceholder: 'Cuéntenos sobre su necesidad...',
    consent: 'Acepto recibir comunicaciones por correo electrónico. *',
    submit: 'Enviar Mensaje',
    sending: 'Enviando...',
  },
  en: {
    heading: 'Send Us a Message',
    formError: 'There was an error submitting the form. Please check the fields and try again.',
    name: 'Name *',
    namePlaceholder: 'Your full name',
    phone: 'Phone *',
    email: 'Email *',
    emailPlaceholder: 'name@email.com',
    serviceType: 'Service Type',
    residential: 'Residential',
    commercial: 'Commercial',
    emergency: '24/7 Emergency',
    address: 'Project Address',
    addressPlaceholder: 'Street, City, Zip Code',
    message: 'Message *',
    messagePlaceholder: 'Tell us about your need...',
    consent: 'I agree to receive email communications. *',
    submit: 'Send Message',
    sending: 'Sending...',
  },
}[locale];
---

<div class="bg-[#F9FAFB] p-8 md:p-10 rounded-[12px] shadow-sm border border-outline-variant">
  <h2 class="font-headline-lg text-[32px] font-bold text-deep-navy mb-8">{copy.heading}</h2>

  <form id="contact-form" class="space-y-6">
    <!-- Success/Error Messages -->
    <div id="form-error" class="hidden p-4 bg-red-100 text-red-800 rounded-lg text-sm font-medium">
      {copy.formError}
    </div>

    <div class="space-y-2">
      <label for="name" class="font-label-lg text-deep-navy block font-semibold">{copy.name}</label>
      <input
        id="name"
        name="name"
        required
        class="w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md"
        placeholder={copy.namePlaceholder}
        type="text"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label for="phone" class="font-label-lg text-deep-navy block font-semibold">{copy.phone}</label>
        <input
          id="phone"
          name="phone"
          required
          pattern="[0-9+() \-]{7,20}"
          class="w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md"
          placeholder="(786) 000-0000"
          type="tel"
        />
      </div>
      <div class="space-y-2">
        <label for="email" class="font-label-lg text-deep-navy block font-semibold">{copy.email}</label>
        <input
          id="email"
          name="email"
          required
          class="w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md"
          placeholder={copy.emailPlaceholder}
          type="email"
        />
      </div>
    </div>

    <div class="space-y-2">
      <label for="service-type" class="font-label-lg text-deep-navy block font-semibold">{copy.serviceType}</label>
      <select
        id="service-type"
        name="service-type"
        class="w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md"
      >
        <option value="residencial">{copy.residential}</option>
        <option value="comercial">{copy.commercial}</option>
        <option value="emergencia">{copy.emergency}</option>
      </select>
    </div>

    <div class="space-y-2">
      <label for="address" class="font-label-lg text-deep-navy block font-semibold">{copy.address}</label>
      <input
        id="address"
        name="address"
        class="w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md"
        placeholder={copy.addressPlaceholder}
        type="text"
      />
    </div>

    <div class="space-y-2">
      <label for="message" class="font-label-lg text-deep-navy block font-semibold">{copy.message}</label>
      <textarea
        id="message"
        name="message"
        required
        class="w-full p-4 rounded-lg border border-outline-variant focus:border-electric-blue focus:ring-2 focus:ring-electric-blue/20 outline-none transition-all bg-white text-body-md"
        placeholder={copy.messagePlaceholder}
        rows="5"
      ></textarea>
    </div>

    <div class="flex items-center gap-3">
      <input
        class="w-5 h-5 text-electric-blue rounded border-outline-variant focus:ring-electric-blue focus:ring-2 focus:ring-offset-0 cursor-pointer"
        id="consent"
        type="checkbox"
        required
      />
      <label class="text-body-md text-on-surface-variant cursor-pointer select-none" for="consent">
        {copy.consent}
      </label>
    </div>

    <button
      id="submit-btn"
      class="w-full bg-electric-blue text-white font-bold py-5 rounded-lg hover:bg-deep-navy transition-all duration-300 scale-up text-[18px] flex items-center justify-center gap-2 cursor-pointer focus:outline-none"
      type="submit"
    >
      <span id="btn-text">{copy.submit}</span>
      <span id="btn-spinner" class="hidden animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full"></span>
    </button>
  </form>
</div>

<script is:inline define:vars={{ submitLabel: copy.submit, sendingLabel: copy.sending }}>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const formError = document.getElementById('form-error');

  if (form && submitBtn && btnText && btnSpinner && formError) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset error state
      formError.classList.add('hidden');

      // Simple HTML5 validation check
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Enter loading state
      submitBtn.disabled = true;
      btnText.textContent = sendingLabel;
      btnSpinner.classList.remove('hidden');

      // Send form submission to API endpoint
      try {
        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          phone: formData.get('phone'),
          email: formData.get('email'),
          'service-type': formData.get('service-type'),
          address: formData.get('address'),
          message: formData.get('message'),
        };

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          throw new Error('Error de servidor');
        }

        // Redirect to thank you page
        window.location.href = '/gracias';
      } catch (error) {
        console.error('Submission error:', error);
        formError.classList.remove('hidden');

        // Reset button state
        submitBtn.disabled = false;
        btnText.textContent = submitLabel;
        btnSpinner.classList.add('hidden');
      }
    });
  }
</script>
