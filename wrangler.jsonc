{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nitza-demo-platform",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nitza-demo-platform",
      "database_id": "1414b2c6-a48b-4dd0-a7bc-77d3fe22932c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TENANT_ASSETS",
      "bucket_name": "nitza-tenant-assets"
    }
  ],
  "routes": [
    // Un solo comodín: cubre tanto los demos (<slug>.nitza.dev) como los
    // paneles por vertical (<vertical>-admin.nitza.dev). La separación entre
    // unos y otros la hace src/middleware.ts, no el enrutado.
    { "pattern": "*.nitza.dev/*", "zone_name": "nitza.dev" }
  ]
}
